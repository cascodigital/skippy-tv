# copie para .env no host do container (chmod 600). Nunca versionar o .env.
# Só segredos aqui: endereços e entidades ficam no house.json.
HASS_TOKEN=<long-lived access token do Home Assistant>
PLEX_TOKEN=<PlexOnlineToken; deixe vazio se não usar Plex>
# PLEX_MID opcional: o house.json (plex.machine_id) já tem
# opcionais (sobrescrevem o house.json): HASS_URL, PLEX_URL, PUBLIC_URL, GO2RTC_URL
